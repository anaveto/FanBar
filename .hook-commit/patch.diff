diff --git a/Tests/FanBarTests/ModeSwitchReadinessTests.swift b/Tests/FanBarTests/ModeSwitchReadinessTests.swift
new file mode 100644
index 0000000..0eecd98
--- /dev/null
+++ b/Tests/FanBarTests/ModeSwitchReadinessTests.swift
@@ -0,0 +1,178 @@
+import XCTest
+@testable import FanBar
+
+@MainActor
+final class ModeSwitchReadinessTests: XCTestCase {
+    private typealias Wait = ModeSwitchReadiness.Wait
+
+    private func fan(_ index: Int, spinState: UInt8?) -> FanReading {
+        FanReading(
+            index: index,
+            minimumRPM: 1_350,
+            currentRPM: 0,
+            maximumRPM: 5_777,
+            isManual: false,
+            spinState: spinState
+        )
+    }
+
+    private func fans(_ spinState: UInt8?) -> [FanReading] {
+        [fan(0, spinState: spinState), fan(1, spinState: spinState)]
+    }
+
+    private func makeController(
+        _ source: FakeFanReadingSource,
+        settleInterval: TimeInterval = ModeSwitchReadiness.handBackSettleInterval
+    ) -> FanController {
+        let controller = FanController(
+            notificationCenter: nil,
+            widgetSnapshotDestination: .disabled,
+            makeReadingSource: { source },
+            refreshInterval: nil,
+            handBackSettleInterval: settleInterval
+        )
+        controller.refresh()
+        return controller
+    }
+
+    func testSwitchWaitsWhileMacOSRunsAFanDown() {
+        XCTAssertEqual(ModeSwitchReadiness.wait(macOSInControl: true, fans: fans(2), awaitingReadingAfterHandBack: false), .spinningDown)
+        XCTAssertEqual(
+            ModeSwitchReadiness.wait(
+                macOSInControl: true,
+                fans: [fan(0, spinState: 3), fan(1, spinState: 2)],
+                awaitingReadingAfterHandBack: true
+            ),
+            .spinningDown
+        )
+    }
+
+    func testSwitchDoesNotWaitForRunningStartingOrStoppedFans() {
+        for state: UInt8 in [1, 3, 5] {
+            XCTAssertNil(
+                ModeSwitchReadiness.wait(macOSInControl: true, fans: fans(state), awaitingReadingAfterHandBack: false),
+                "F0St = \(state)"
+            )
+        }
+    }
+
+    func testRunningFansWaitWhileAHandBackSettles() {
+        for state: UInt8? in [5, nil] {
+            // Readings from the helper carry no fan state (nil); the hand-back still waits.
+            XCTAssertEqual(
+                ModeSwitchReadiness.wait(macOSInControl: true, fans: fans(state), awaitingReadingAfterHandBack: true),
+                .handBackSettling
+            )
+        }
+    }
+
+    func testMacsWithoutTheFanStateKeyNeverWait() {
+        XCTAssertNil(ModeSwitchReadiness.wait(macOSInControl: true, fans: fans(nil), awaitingReadingAfterHandBack: false))
+        XCTAssertNil(ModeSwitchReadiness.wait(macOSInControl: true, fans: [], awaitingReadingAfterHandBack: false))
+        let handedBackAt = Date()
+        XCTAssertTrue(ModeSwitchReadiness.readingSettlesHandBack(
+            readAt: handedBackAt,
+            handedBackAt: handedBackAt,
+            reportsFanState: false
+        ))
+    }
+
+    func testFanBarControlNeverWaits() {
+        // The wait covers taking the fans from macOS only.
+        XCTAssertNil(ModeSwitchReadiness.wait(macOSInControl: false, fans: fans(2), awaitingReadingAfterHandBack: true))
+    }
+
+    func testOnlyAReadingLateEnoughToShowMacOSChoiceSettlesAHandBack() {
+        let handedBackAt = Date()
+        func settles(after seconds: TimeInterval) -> Bool {
+            ModeSwitchReadiness.readingSettlesHandBack(
+                readAt: handedBackAt.addingTimeInterval(seconds),
+                handedBackAt: handedBackAt,
+                reportsFanState: true
+            )
+        }
+        XCTAssertFalse(settles(after: 0.5))
+        XCTAssertFalse(settles(after: 1.9))
+        XCTAssertTrue(settles(after: ModeSwitchReadiness.handBackSettleInterval))
+        XCTAssertTrue(settles(after: 5))
+    }
+
+    func testOnlyRetriesThatTakeTheFansWait() {
+        typealias Recovery = FanController.ModeActionFeedback.Recovery
+        let performance = CoolingPresetID.builtIn(.performance)
+        XCTAssertTrue(ModeSwitchReadiness.locks(Recovery.retry(.preset(performance)), whileWaiting: true))
+        XCTAssertTrue(ModeSwitchReadiness.locks(Recovery.retry(.fixed(3_000)), whileWaiting: true))
+        XCTAssertFalse(ModeSwitchReadiness.locks(Recovery.retry(.restore), whileWaiting: true))
+        XCTAssertFalse(ModeSwitchReadiness.locks(Recovery.openHelperSettings, whileWaiting: true))
+        XCTAssertFalse(ModeSwitchReadiness.locks(Recovery.retry(.preset(performance)), whileWaiting: false))
+    }
+
+    func testProgressLineShowsARequestInFlightBeforeTheWait() {
+        XCTAssertEqual(ModeSwitchReadiness.progressMessage(inProgress: "Switching…", wait: .spinningDown), "Switching…")
+        XCTAssertEqual(ModeSwitchReadiness.progressMessage(inProgress: nil, wait: .spinningDown), ModeSwitchReadiness.waitingMessage)
+        XCTAssertEqual(ModeSwitchReadiness.progressMessage(inProgress: nil, wait: .handBackSettling), ModeSwitchReadiness.checkingMessage)
+        XCTAssertNil(ModeSwitchReadiness.progressMessage(inProgress: nil, wait: nil))
+    }
+
+    func testControllerWaitsWhileItsLatestReadingShowsAFanRunningDown() {
+        let source = FakeFanReadingSource(readings: fans(5))
+        let controller = makeController(source, settleInterval: 0)
+        XCTAssertEqual(controller.mode, .automatic)
+        XCTAssertNil(controller.modeSwitchWait)
+
+        source.readings = fans(2)
+        controller.refresh()
+        XCTAssertEqual(controller.modeSwitchWait, .spinningDown)
+        XCTAssertTrue(controller.mustWaitForFans)
+
+        source.readings = fans(3)
+        controller.refresh()
+        XCTAssertNil(controller.modeSwitchWait)
+        XCTAssertFalse(controller.mustWaitForFans)
+    }
+
+    func testLaunchWaitsForAReadingLateEnoughToShowMacOSChoice() {
+        // Quitting FanBar hands the fans back, so a launch can follow a hand-back closely.
+        let source = FakeFanReadingSource(readings: fans(5))
+        source.sampledAt = Date().addingTimeInterval(1)
+        let controller = makeController(source)
+        XCTAssertEqual(controller.modeSwitchWait, .handBackSettling)
+
+        source.sampledAt = Date().addingTimeInterval(ModeSwitchReadiness.handBackSettleInterval + 1)
+        controller.refresh()
+        XCTAssertNil(controller.modeSwitchWait)
+    }
+
+    func testHandBackWaitsForAReadingLateEnoughToShowMacOSChoice() {
+        let source = FakeFanReadingSource(readings: fans(5))
+        source.sampledAt = Date().addingTimeInterval(ModeSwitchReadiness.handBackSettleInterval + 1)
+        let controller = makeController(source)
+        XCTAssertNil(controller.modeSwitchWait)
+
+        // A click before macOS has stopped the fans: the reading still shows them running.
+        controller.setAutomatic()
+        XCTAssertEqual(controller.modeSwitchWait, .handBackSettling)
+        source.sampledAt = Date().addingTimeInterval(1)
+        controller.refresh()
+        XCTAssertEqual(controller.modeSwitchWait, .handBackSettling)
+
+        // macOS kept the fans running: the switch can start.
+        source.sampledAt = Date().addingTimeInterval(ModeSwitchReadiness.handBackSettleInterval + 1)
+        controller.refresh()
+        XCTAssertNil(controller.modeSwitchWait)
+
+        // macOS stopped the fans: the spin-down wait takes over.
+        controller.setAutomatic()
+        source.readings = fans(2)
+        source.sampledAt = Date().addingTimeInterval(ModeSwitchReadiness.handBackSettleInterval + 1)
+        controller.refresh()
+        XCTAssertEqual(controller.modeSwitchWait, .spinningDown)
+    }
+
+    func testMacsWithoutTheFanStateKeyDoNotWaitAfterAHandBack() {
+        let controller = makeController(FakeFanReadingSource())
+        XCTAssertNil(controller.modeSwitchWait)
+        controller.setAutomatic()
+        XCTAssertNil(controller.modeSwitchWait)
+    }
+}
