diff --git a/Sources/FanBar/ModeSwitchReadiness.swift b/Sources/FanBar/ModeSwitchReadiness.swift
new file mode 100644
index 0000000..54f05bd
--- /dev/null
+++ b/Sources/FanBar/ModeSwitchReadiness.swift
@@ -0,0 +1,90 @@
+import FanBarShared
+import Foundation
+
+/// Whether the panel can start a switch that takes the fans from macOS.
+///
+/// When macOS stops a fan, the SMC reports `F%dSt` = 2 until the fan has run down,
+/// and only then 3 (stopped). A fan in state 2 does not start again before that,
+/// even with a new target, and the SMC accepts manual mode only from a running fan.
+/// The helper gives that takeover 10 s, so a switch started while a fan runs down
+/// fails and hands the fans back. Measured on a Mac16,7 (M4 Pro, macOS 27.2.1):
+/// state 2 lasts about 11 s after macOS stops the fans from 1,350 RPM, and a
+/// takeover from state 3 takes 7–8 s. Quitting FanBar hands the fans back, so this
+/// state follows every restart while the Mac is cool.
+enum ModeSwitchReadiness {
+    /// Why the mode strip waits.
+    enum Wait: Equatable {
+        /// FanBar just handed the fans to macOS; no SMC reading shows macOS's choice yet.
+        case handBackSettling
+        /// A fan runs down (`F%dSt` = 2).
+        case spinningDown
+    }
+
+    /// `F%dSt` while a stopped fan runs down.
+    static let spinningDownState: UInt8 = 2
+
+    /// How long after a hand-back an SMC reading still predates macOS's choice.
+    /// In three measured hand-backs, macOS set target 0 (and `F%dSt` = 2)
+    /// 0.97–1.16 s after FanBar released the fans and took system mode after
+    /// 2.0–2.1 s; an earlier reading still shows the fans running.
+    static let handBackSettleInterval: TimeInterval = 2
+
+    /// Nil when a switch can start. Macs without `F%dSt` never wait.
+    static func wait(macOSInControl: Bool, fans: [FanReading], awaitingReadingAfterHandBack: Bool) -> Wait? {
+        guard macOSInControl else { return nil }
+        if fans.contains(where: { $0.spinState == spinningDownState }) { return .spinningDown }
+        return awaitingReadingAfterHandBack ? .handBackSettling : nil
+    }
+
+    /// Whether an SMC reading ends the wait that a hand-back started: it must come
+    /// late enough to show macOS's choice, unless the Mac has no `F%dSt` at all.
+    static func readingSettlesHandBack(
+        readAt: Date,
+        handedBackAt: Date,
+        reportsFanState: Bool,
+        settleInterval: TimeInterval = handBackSettleInterval
+    ) -> Bool {
+        !reportsFanState || readAt.timeIntervalSince(handedBackAt) >= settleInterval
+    }
+
+    /// Only a retry that takes the fans waits; handing them back to macOS
+    /// and the helper or sensor fixes stay available.
+    static func locks(_ recovery: FanController.ModeActionFeedback.Recovery, whileWaiting waiting: Bool) -> Bool {
+        guard waiting, case .retry(let target) = recovery else { return false }
+        return target != .restore
+    }
+
+    /// The line beside the spinner: a request in flight first, then the wait.
+    static func progressMessage(inProgress: String?, wait: Wait?) -> String? {
+        if let inProgress { return inProgress }
+        switch wait {
+        case .spinningDown: return waitingMessage
+        case .handBackSettling: return checkingMessage
+        case nil: return nil
+        }
+    }
+
+    static var waitingMessage: String {
+        fanBarText("风扇正在停转，稍后可切换模式…", "Fans are spinning down. Modes unlock shortly…")
+    }
+
+    static var checkingMessage: String {
+        fanBarText("正在检查风扇…", "Checking the fans…")
+    }
+}
+
+extension FanController {
+    /// Why the mode strip waits now, if it does; see `ModeSwitchReadiness`.
+    var modeSwitchWait: ModeSwitchReadiness.Wait? {
+        ModeSwitchReadiness.wait(
+            macOSInControl: mode == .automatic,
+            fans: fans,
+            awaitingReadingAfterHandBack: fansHandedBackAt != nil
+        )
+    }
+
+    /// True while switches that take the fans from macOS wait.
+    var mustWaitForFans: Bool {
+        modeSwitchWait != nil
+    }
+}
